#!/bin/sh
# The push proves; the commit stays fast. Install once per clone:
#
#     git config core.hooksPath .githooks
#
# One gate, fail-closed: the project's own definition of done
# (.github/scripts/check.sh). It ends with a machine secret scan over every
# commit this fork added - the prose rule "check before pushing" does not
# survive a tired evening; a scan does.
#
# The gates need Home Assistant, which only runs on Linux. Pushed from Windows
# (Git for Windows, GitHub Desktop) the hook therefore hands the work to WSL;
# pushed from inside WSL or Linux it runs directly. Machine-local details
# arrive through the environment:
#
#     HA_TEST_PYTHON   interpreter with Home Assistant and the test plugin
#                      (default: $HOME/ha-dev/venv/bin/python, inside WSL)
#     MIN_HA_PYTHON    interpreter with the MINIMUM Home Assistant hacs.json
#                      declares (default: $HOME/ha-dev/venv-min-2026.9/bin/python)
#     WSL_DISTRO       the distribution to use from Windows (default: Ubuntu)
set -eu

repository="$(git rev-parse --show-toplevel)"

run_gates() {
    cd "$1"
    PYTHON="${HA_TEST_PYTHON:-$HOME/ha-dev/venv/bin/python}" \
        MIN_HA_PYTHON="${MIN_HA_PYTHON:-$HOME/ha-dev/venv-min-2026.9/bin/python}" \
        sh .github/scripts/check.sh
}

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        # Windows: the same script, re-entered inside WSL. The path travels
        # as an environment variable with WSLENV's /p flag, which translates
        # it to a /mnt path on the way in - argument quoting through wsl.exe
        # does not survive a space in the path, this does.
        REPO_WIN="$(cygpath -w "$repository")" WSLENV="REPO_WIN/p${WSLENV:+:$WSLENV}"             exec wsl.exe -d "${WSL_DISTRO:-Ubuntu}" -- bash -lc             'cd "$REPO_WIN" && sh .githooks/pre-push'
        ;;
    *)
        run_gates "$repository"
        ;;
esac
